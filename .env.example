# Gunakan connection string PostgreSQL dari Neon/Supabase/Railway.
# Untuk Supabase, gunakan connection pooling untuk DATABASE_URL dan
# DIRECT_URL untuk proses migrasi.
DATABASE_URL="postgresql://user:password@host:5432/nama_database?schema=public"

# Buat nilai acak minimal 32 karakter, contoh:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="ganti-dengan-secret-acak-yang-panjang"
