generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum LoanStatus {
  DIPINJAM
  SELESAI
}

model User {
  id           String        @id @default(cuid())
  name         String
  username     String        @unique
  email        String?       @unique
  passwordHash String
  role         Role          @default(STAFF)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  loans        Loan[]
  activities   ActivityLog[]

  @@index([role, isActive])
}

model Item {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    String
  stock       Int      @default(0)
  minStock    Int      @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  loans       Loan[]

  @@index([name])
  @@index([category])
}

model Loan {
  id           String     @id @default(cuid())
  code         String     @unique
  borrowerName String
  borrowerInfo String?
  itemId       String?
  item         Item?      @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemCode     String
  itemName     String
  quantity     Int
  borrowDate   DateTime
  dueDate      DateTime?
  returnDate   DateTime?
  status       LoanStatus @default(DIPINJAM)
  notes        String?
  officerId    String
  officer      User       @relation(fields: [officerId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([borrowerName])
  @@index([borrowDate])
  @@index([itemId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  description String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}
